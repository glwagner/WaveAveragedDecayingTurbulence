#!/bin/bash
#SBATCH --job-name=wise-sanity
#SBATCH --output=sanity-%j.log
#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --partition=gpu-dev
#SBATCH --gres=gpu:1

set -euo pipefail
cd /shared/home/greg/WaveAveragedDecayingTurbulence

echo "=== node ==="; hostname; nvidia-smi -L
echo "=== julia ==="; julia --version

# Tiny grid + short stop_time so we measure iter/sec without finishing the long run.
export N=128
export STOP_TIME=5
export SANITY=1
export JULIA_CUDA_HARD_MEMORY_LIMIT=70%

echo "=== running ==="
julia --project=. runs/decaying_turbulence_256_wise.jl
